# The bot's settings and secrets. Copy to .env (gitignored), fill in, chmod 600.
#   docker compose reads it (env_file in docker-compose.yml).
#   For a foreground run without Docker:  set -a; . slack-bridge/.env; set +a
# One KEY=value per line, no `export`, no quotes, no spaces around `=`.

# --- Required ---------------------------------------------------------------
SLACK_BOT_TOKEN=xoxb-
SLACK_APP_TOKEN=xapp-
# Channel IDs (C0...), comma-separated. Empty refuses everyone, on purpose.
SLACK_ALLOWED_CHANNELS=
ANTHROPIC_API_KEY=sk-ant-

# --- Optional (defaults shown) ---------------------------------------------
# SLACK_ALLOWED_USERS=
# SLACK_ALLOW_DMS=0
# BRIDGE_MODEL=claude-sonnet-5-5
# BRIDGE_EFFORT=medium
# BRIDGE_TIMEOUT_S=30
# BRIDGE_MAX_CONCURRENT=2
# BRIDGE_ALLOWED_HOSTS=axon-gotcha-[0-9]+
# BRIDGE_ALLOW_PING=1
# Login on the sites, if it isn't `gotcha` (the bot's user inside the container):
# GOTCHA_SSH_USER=gotcha

# Docker only: the uid/gid of the host user that owns ~/.ssh and the gotcha30 clone (`id`).
# BOT_UID=1000
# BOT_GID=1000
