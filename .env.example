# Copy to .env — it is gitignored, and read at startup by env_file.py.
#
# Nothing here overrides a variable you already exported: the shell, a systemd unit and a
# container's environment all win over this file, so a stale value cannot shadow the one
# you are testing with.

# console.anthropic.com -> Settings -> API keys -> Create key. Shown once.
# Alternatives, in the SDK's own order of precedence: ANTHROPIC_AUTH_TOKEN, an OAuth
# profile from `ant auth login`, workload identity federation — or type a key into the
# console's Run tab, which stores it in secrets.local.env instead.
ANTHROPIC_API_KEY=

GOTCHA30_REPO=/home/gal/Documents/code/gotcha30
GOTCHA30_CONFIG=configs/two_sensor_test.yaml
# Optional: central registry of systems across sites (see systems_inventory.example.yaml)
# SYSTEMS_INVENTORY=systems_inventory.yaml
# Optional: override the model. Defaults to claude-opus-5.
# AGENT_MODEL=claude-opus-5
