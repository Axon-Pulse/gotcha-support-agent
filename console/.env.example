# The console's settings. Copy to .env (gitignored), chmod 600. Read by `make run` and the
# systemd unit (EnvironmentFile).

# Tailnet logins allowed in, comma-separated, as Tailscale shows them (e.g. name@company.com).
# Empty lets nobody in from the tailnet.
CONSOLE_ALLOWED_USERS=

# Of those, who may reveal and change the bot's secrets (the Secrets tab). Everyone else
# is a viewer: secret names only. Comma-separated, same form as above.
CONSOLE_ADMINS=

# Signing in takes a code from an authenticator app; set each user up on this machine with
#   make -C console totp-enroll EMAIL=name@company.com
# How long a sign-in lasts, and how long one code unlocks revealing secrets:
# CONSOLE_SESSION_HOURS=12
# CONSOLE_STEPUP_SECONDS=1800
# Host names the console may be opened as, comma-separated (blocks DNS rebinding). Empty
# accepts any; set it once you know the address, e.g. gotcha-server.tail1234.ts.net,gotcha-server
# CONSOLE_ALLOWED_HOSTS=
# Passkeys are bound to the host name the page is opened on; to fix one instead:
# CONSOLE_RP_ID=gotcha-server.<tailnet>.ts.net

# 1 lets in a request with no tailnet login, i.e. one made on this machine without going
# through `tailscale serve`. For `make dev` only: in the service it would also let in any
# tagged device on the tailnet, which tailscale serve forwards without a login.
# CONSOLE_ALLOW_LOCAL=0
# The role such a local request gets (viewer or admin). Enrol it as EMAIL=local.
# CONSOLE_LOCAL_ROLE=viewer

# Only to point the console somewhere other than this checkout:
# CONSOLE_SKILL_DIR=/path/to/support-agent-skill
# CONSOLE_BRIDGE_DIR=/path/to/slack-bridge
# CONSOLE_TRANSCRIPT_DIRS=/dir/one:/dir/two
# CONSOLE_CONTAINER=gotcha-support-bot
